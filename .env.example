# DefectLens configuration. Copy to `.env` in the repository root (or export the variables) and edit.
# Every variable is optional in development; the values below are the built-in defaults unless noted.
# NEVER commit a real `.env` - it is gitignored.

# --- Environment ---------------------------------------------------------------------------------------------
# development | production | test. `production` enforces: DL_SECRET_KEY set (>=32 chars), a strong admin
# password, CSP frame-ancestors 'self', and no demo inspector/viewer accounts.
DL_ENV=development

# Signing key for session tokens. Dev: auto-generated into <var>/secret.key. Production: REQUIRED.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DL_SECRET_KEY=

# --- Storage -------------------------------------------------------------------------------------------------
# Runtime state (database, uploaded images, datasets, models, reports). Default: <repo>/var
# DL_VAR_DIR=/srv/defectlens/var
# DL_DATASETS_DIR=            # default <var>/datasets
# DL_MODELS_DIR=              # default <var>/models
# SQLite by default (<var>/defectlens.db). PostgreSQL (install the `postgres` extra):
# DL_DATABASE_URL=postgresql+psycopg://defectlens:CHANGE_ME@localhost:5432/defectlens
DL_AUTO_MIGRATE=true

# --- First-run admin account (created only if no users exist) ------------------------------------------------
DL_ADMIN_USERNAME=admin
# Change this! The app warns until it is changed; production refuses weak values.
DL_ADMIN_PASSWORD=change-me-now
# Demo accounts inspector/inspector-demo and viewer/viewer-demo (never created in production)
DL_SEED_DEMO_USERS=true

# --- HTTP / security -----------------------------------------------------------------------------------------
DL_SERVE_FRONTEND=true                   # FastAPI serves frontend/dist (single port, recommended)
DL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # only for the Vite dev server
DL_COOKIE_SECURE=false                   # set true behind HTTPS
DL_ACCESS_TOKEN_MINUTES=480
DL_FRAME_ANCESTORS=                      # CSP frame-ancestors; empty = 'self' in production, unrestricted in dev
DL_RATE_LIMIT_PER_MIN=600                # per client IP, all API routes
DL_LOGIN_RATE_LIMIT_PER_MIN=10           # per client IP, login attempts

# --- Upload limits -------------------------------------------------------------------------------------------
DL_MAX_UPLOAD_MB=20                      # per image
DL_MAX_ZIP_MB=500
DL_MAX_ZIP_FILES=2000
DL_MAX_ZIP_UNCOMPRESSED_MB=4000
DL_DUPLICATE_WINDOW_HOURS=24             # identical image + same model within this window -> reuse result

# --- Inference / jobs ----------------------------------------------------------------------------------------
DL_DEVICE=auto                           # auto | cpu | cuda | cuda:0 ...
DL_MODEL_CACHE_SIZE=3                    # models kept in memory (~100-200 MB each)
DL_WARMUP_MODELS=true                    # load active models in the background at startup
DL_WORKER_MODE=thread                    # thread (in-process) | external (`defectlens worker`) | off
DL_WORKER_POLL_SECONDS=1.0
DL_JOB_STALE_SECONDS=300                 # running jobs without heartbeat are recovered after this

# --- Logging -------------------------------------------------------------------------------------------------
DL_LOG_FORMAT=text                       # text | json (structured, for log shippers)
DL_LOG_LEVEL=INFO

# --- Optional AI text providers ------------------------------------------------------------------------------
# Not required. Providers are configured in Settings -> AI providers. Keys can be pasted there (stored
# server-side, encrypted with DL_SECRET_KEY, never returned to the browser) or referenced by env var name:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
